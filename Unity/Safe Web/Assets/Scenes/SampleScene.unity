  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A entidade Museus e Monumentos de Portugal deu ordens para fechar o Museu
    Historiadores e Exploradores ap\xF3s uma inspe\xE7\xE3o feita \xE0 infraestrutura
    revelar problemas graves na fachada do edif\xEDcio que colocavam a seguran\xE7a
    dos trabalhadores e visitantes em risco. \r\nSem previs\xE3o para reabertura,
    pais de estudantes que visitaram o museu est\xE3o revoltados com esta not\xEDcia.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e494d9298d9fb134c8fee14b80015fe9, type: 2}
