  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Bem-vindo Delegado(a) de Turma ao teu novo cargo! De modo a auxiliar os
    teus colegas com os seus problemas e perguntas o Agrupamento de Escolas Vila
    Azul disponibiliza \xE0 sua equipa de Delegados aplica\xE7\xF5es e documentos
    guia que podem ser consultados no caso de d\xFAvidas.\r\nNo lado esquerdo do
    ecr\xE3 poder\xE1s encontrar os \xEDcones Website da Escola, que, como o nome
    indica, abre o website da escola, e Informa\xE7\xE3o, que cont\xE9m documentos
    relevantes \xE0s tarefas que ir\xE1s realizar.\r\nNo lado direito do ecr\xE3
    encontra-se o Chatroom, onde tu e os teus colegas podem socializar uns com os
    outros; o Email, onde ir\xE1s receber e responder aos pedidos de ajuda; e o Pesquisa,
    o navegador de busca oferecido pelo Agrupamento."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e494d9298d9fb134c8fee14b80015fe9, type: 2}
  m_sharedMaterial: {fileID: 4449789550291841673, guid: e494d9298d9fb134c8fee14b80015fe9, type: 2}
